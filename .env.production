# just a flag
ENV = 'production'


# base api
# VUE_APP_BASE_API = '/prod-api'
# API2 = 审批中心(flowable)，API3 = 仓库模块(WMS)。
# 这两项之前是注释状态，而 settingMer.js 在取不到时会 fallback 到 location.origin，
# 请求就打到前端自己的 nginx 上——nginx 只代理了 /api/admin/，没有 warehouse/flowable 的
# location，于是走 try_files 落到静态文件处理，表现为 405 或长时间挂起后超时。
# 线上现有构建其实是带着这两个值的（构建产物里能 grep 到），说明配置一直没入库，补上。
VUE_APP_BASE_API = 'http://192.168.3.77:8909/admin'
VUE_APP_BASE_API2 = 'http://192.168.3.77:9877'
VUE_APP_BASE_API3 = 'http://192.168.3.77:8909/warehouse'
VUE_APP_BASE_API4 = 'http://192.168.3.77:8909/flink'
VUE_APP_BASE_API5 = 'http://192.168.3.77:8909/front'
VUE_APP_BASE_API6 = 'http://192.168.3.77:8909/alliance'

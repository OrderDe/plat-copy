# just a flag
ENV = 'development'

# base api —— 本地调试：一律走本机网关 8909，服务全在自己 IDE 里跑
#
# 网关启动务必带上 -DUPSTREAM_HOST=127.0.0.1，否则它会按默认值把请求
# 转发到 192.168.3.81 上的服务（那台没有联盟服务，会返回 500）。
# 基础设施（MySQL/Redis/Nacos）仍在 3.81，由各服务的 infra.host 管，与这里无关。
#
# 要临时切回 3.81 那套整体环境，把下面 6 行的 localhost 换成 192.168.3.81 即可，
# 但 3.81 上没有部署联盟服务，API6 换过去会 404。
VUE_APP_BASE_API = 'http://localhost:8909/admin'
# flowable 是直连、不过网关（9877）。本机没起这个服务时审批相关页面会连不上。
VUE_APP_BASE_API2 = 'http://localhost:9877'
VUE_APP_BASE_API3 = 'http://localhost:8909/warehouse'
# flink（9847）本机没起时，推荐配置页会连不上
VUE_APP_BASE_API4 = 'http://localhost:8909/flink'
VUE_APP_BASE_API5 = 'http://localhost:8909/front'
VUE_APP_BASE_API6 = 'http://localhost:8909/alliance'
# vue-cli uses the VUE_CLI_BABEL_TRANSPILE_MODULES environment variable,
# to control whether the babel-plugin-dynamic-import-node plugin is enabled.
# It only does one thing by converting all import() to require().
# This configuration can significantly increase the speed of hot updates,
# when you have a large number of pages.
# Detail:  https://github.com/vuejs/vue-cli/blob/dev/packages/@vue/babel-preset-app/index.js

VUE_CLI_BABEL_TRANSPILE_MODULES = true

